{
  "name": "@gostsign/core",
  "version": "0.1.0",
  "description": "PAdES-подпись PDF сертификатами ГОСТ через КриптоПро ЭЦП Browser plug-in",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",

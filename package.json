    "typecheck": "tsc --noEmit",
    "check": "vite-node scripts/check-incremental.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vite-node": "^6.0.0"
  }
}
